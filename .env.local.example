# Copy this file to .env.local and fill in the values from your Supabase project settings.
# Never commit .env.local — it is gitignored.

# Supabase project URL and anon (public) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server-only, NEVER expose to the browser or client bundles.
# Used later for privileged server-side operations (e.g. LINE webhook handlers).
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the scheduled-broadcast processing route
# (/api/broadcasts/process-due). Generate any long random string (e.g.
# `openssl rand -hex 32`) and configure your scheduler (Vercel Cron Jobs,
# or any other cron/HTTP-trigger service) to call that route on an
# interval, sending this value as `Authorization: Bearer <value>` (Vercel
# Cron does this automatically when CRON_SECRET is set in its own env) or
# as a `?secret=` query param. Nothing sends scheduled broadcasts without
# this being configured and something actually calling the route.
CRON_SECRET=
